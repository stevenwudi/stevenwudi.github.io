---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | ImageMetadata[];
  alt: string | string[];
  id?: string;
  narrow?: boolean;
}

const { src, alt, id, narrow = false } = Astro.props;
const images = Array.isArray(src) ? src : [src];
const alts = Array.isArray(alt) ? alt : [alt];
---

<figure class:list={['figure', { 'figure--narrow': narrow }]} id={id}>
  <div class="figure__images" style={`--cols: ${images.length}`}>
    {
      images.map((image, i) => (
        <a class="figure__link" href={image.src} title="Open the full-size image">
          <Image src={image} alt={alts[i] ?? ''} width={images.length > 1 ? 640 : 1100} />
        </a>
      ))
    }
  </div>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>
