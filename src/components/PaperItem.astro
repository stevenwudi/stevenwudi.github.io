---
import { Image } from 'astro:assets';
import { isMe, toBibtex, TOPICS, type Publication } from '../data/publications';

interface Props {
  paper: Publication;
}

// One entry on /publications/ (figure, abstract, cite, topics). The homepage uses PaperCard.
const { paper } = Astro.props;
const search = [paper.title, ...paper.authors, paper.venue, paper.venueFull, paper.year, paper.abstract ?? '']
  .join(' ')
  .toLowerCase();
const topicLabels = paper.topics.map((t) => TOPICS.find((x) => x.id === t)?.label).filter(Boolean);
---

<li class="paper paper--full reveal" id={paper.id} data-topics={paper.topics.join(' ')} data-search={search}>
  {
    paper.image ? (
      <a class="paper__thumb" href={paper.image.src} aria-label={`Figure from “${paper.title}” (full size)`}>
        <Image src={paper.image} alt={paper.imageAlt ?? ''} width={352} />
      </a>
    ) : (
      <span class="paper__thumb paper__thumb--empty" aria-hidden="true">
        <span>{paper.venue}</span>
        <small>{paper.year}</small>
      </span>
    )
  }
  <div>
    <h3 class="paper__title">{paper.title}</h3>
    <p class="paper__authors">
      {paper.authors.map((author, i) => [i > 0 ? ', ' : '', isMe(author) ? <strong>{author}</strong> : author])}
    </p>
    <p class="paper__venue">
      <span class="badge">{paper.venue} {paper.year}</span>
      <span class="meta">{paper.venueFull}</span>
      {paper.note && <span class="badge badge--accent">{paper.note}</span>}
    </p>
    {
      (
        <p class="paper__links">
          {paper.links?.map((link) => (
            <a href={link.href}>
              {link.label} <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ))}
          <button class="paper__cite" type="button" data-bibtex={toBibtex(paper)} hidden>
            Cite
          </button>
          <span class="paper__topics meta">{topicLabels.join(' · ')}</span>
        </p>
      )
    }
    {
      paper.abstract && (
        <details>
          <summary>Abstract</summary>
          <p>{paper.abstract}</p>
        </details>
      )
    }
  </div>
</li>
