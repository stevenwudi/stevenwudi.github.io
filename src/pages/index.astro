---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import SocialIcons from '../components/SocialIcons.astro';
import Figure3D from '../components/Figure3D.astro';
import Section from '../components/Section.astro';
import TimelineDog from '../components/TimelineDog.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import PaperCard from '../components/PaperCard.astro';
import { SITE, PROFILES } from '../data/site';
import { EXPERIENCE } from '../data/experience';
import { HONOURS } from '../data/work';
import { PUBLICATIONS } from '../data/publications';

// "Top x% of n teams" for honours with a known field size.
const field = (rank: string, of?: string) => {
  if (!of) return undefined;
  const n = Number(of.replace(/,/g, ''));
  const top = (Number(rank) / n) * 100;
  return { top: top < 10 ? top.toFixed(1) : Math.round(top), ahead: (n - Number(rank)) / n };
};
---

<Base current="home">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 class="hero__name" id="hero-title">
        <span>Di Wu</span>
        <Seal label={SITE.nameZh} />
      </h1>
      <p class="hero__lead">
        is an AI researcher and educator at the crossroads of AI and robotics. He enjoys using machine learning —
        from probabilistic graphical models to deep networks — for high-level computer vision: recognising human actions
        and gestures, tracking, and recovering the full 3D pose of objects: the 2D-to-3D, “inverse graphics” problem.
      </p>
      <p class="hero__bio">
        He received his PhD from the University of Sheffield, U.K., and his bachelor’s from Zhejiang University, China, then
        did postdocs at the Idiap Research Institute — affiliated with EPFL, in a beautiful Swiss Alpine town — and at
        Shenzhen University, before moving to industry. He is now at <a href={SITE.current.href}>{SITE.current.org}</a>,
        and hopes to use machine learning to solve real-world problems.
      </p>
      <div class="hero__actions">
        <SocialIcons />
        {
          SITE.cv && (
            <a class="text-link" href={SITE.cv}>
              CV <span class="arrow" aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
    <Figure3D />
  </section>

  <Section id="bio" num="01" title="Bio" intro="Where I have worked and studied.">
    <div class="timeline-wrap">
      <ol class="timeline" role="list">
        {
          EXPERIENCE.map((r) => (
            <li class="timeline__item reveal">
              <span class="timeline__period">{r.period}</span>
              <span class="timeline__mark">
                <img class="timeline__logo" src={r.logo} alt="" width="56" height="56" loading="lazy" decoding="async" />
              </span>
              <p class="timeline__desc" set:html={r.desc} />
            </li>
          ))
        }
      </ol>
      <TimelineDog />
    </div>
  </Section>

  <Section id="work" num="02" title="Work" intro="Things I have built, and challenges entered along the way." stacked>
    <WorkShowcase />

    <h3 class="subhead label" id="honours">Honours &amp; challenges</h3>
    <ol class="honours" role="list" aria-labelledby="honours">
      {
        HONOURS.map((h) => (
          <li class:list={['honour', 'reveal', { 'honour--first': h.rank === '1' }]}>
            <span class="honour__rank">
              {h.rank}<sup>{h.suffix}</sup>
            </span>
            <div>
              <p class="honour__event">
                {h.href ? (
                  <a href={h.href}>
                    {h.event} <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  h.event
                )}
              </p>
              <p class="honour__detail meta">{h.detail}</p>
              {(() => {
                const f = field(h.rank, h.of);
                return (
                  f && (
                    <p class="honour__field">
                      <span class="meta">
                        Top {f.top}% of {h.of} teams
                      </span>
                    </p>
                  )
                );
              })()}
            </div>
            <span class="honour__year">{h.year ?? ''}</span>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="papers" num="03" title="Papers" intro={`${PUBLICATIONS.length} publications, newest first.`}>
    <ul class="pcards" role="list">
      {PUBLICATIONS.map((paper) => <PaperCard paper={paper} />)}
    </ul>
  </Section>

</Base>

